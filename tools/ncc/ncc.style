ClassName: '^[A-Z][a-zA-Z0-9]*$'
CppMethod: '^operator|^FUN_[a-f0-9]{8}$|^[a-zA-Z][a-zA-Z0-9]*$'
EnumName: '^\(unnamed|^[A-Z][a-zA-Z0-9]*$'
EnumConstantName: '^lego_[0-9]+$|^[A-Z][A-Z0-9_]*$|^[A-Z][a-zA-Z0-9]*$'
FunctionName: '^operator|^FUN_[a-f0-9]{8}$|^[a-zA-Z][a-zA-Z0-9]*$'
ParameterName: '^p_unk0x[a-f0-9]{1,8}$|^[a-z][a-zA-Z0-9]*$|^$'
StructName: '^\(anon|^\(unnamed|^[A-Z][a-zA-Z0-9]*$'
TypedefName: '^[A-Z][a-zA-Z0-9]*$'
UnionName: '^\(anon|^\(unnamed|^[A-Z][a-zA-Z0-9]*$'
VariableName:
    ScopePrefix:
        Global: ''
        Static: ''
        ClassMember: ''
        StructMember: ''
    DataTypePrefix:
        String: ''
        Integer: ''
        Bool: ''
        Pointer: ''
    Pattern: '^[gmp]_unk0x[a-f0-9]{1,8}$|^(prop|event|desc)_[a-zA-Z][a-zA-Z0-9]*$|^[a-z][a-zA-Z0-9]*$'
