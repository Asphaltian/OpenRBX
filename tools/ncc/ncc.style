ClassName: '^[A-Z][a-zA-Z0-9]*$'
CppMethod: '^operator|^on_[a-z][a-zA-Z0-9]*$|^onEvent_[a-z][a-zA-Z0-9]*$|^onEvent_HoleAncestorChanged$|^onEvent_(AddedBackend|RemovedBackend|HandleTouched)$|^(upTo|downFrom)_[A-Z][a-zA-Z0-9]*$|^FUN_[a-f0-9]{8}$|^print_exception$|^getfmod_version$|^disconnect_all_slots$|^c_str$|^(descriptors|members|properties|functions|signals|derivedClasses)_(begin|end)$|^[a-zA-Z][a-zA-Z0-9]*$'
EnumName: '^\(unnamed|^[A-Z][a-zA-Z0-9]*$'
EnumConstantName: '^lego_[0-9]+$|^[A-Z][A-Z0-9_]*$|^[A-Z][a-zA-Z0-9]*$'
FunctionName: '^operator|^FUN_[a-f0-9]{8}$|^lua_(pushfunction|tofunction|tofloat)$|^[a-zA-Z][a-zA-Z0-9]*$'
ParameterName: '^p_unk0x[a-f0-9]{1,8}$|^_(First|Last|To|St|Endl)$|^L$|^[AB]$|^DelayFunction$|^_?[a-z][a-zA-Z0-9]*$|^$'
StructName: '^\(anon|^\(unnamed|^myLess$|^crlf$|^noline$|^lua_State$|^luaL_Reg$|^_TOKEN_MANDATORY_LABEL$|^[A-Z][a-zA-Z0-9]*$'
TypedefName: '^P?TOKEN_MANDATORY_LABEL$|^[A-Z][a-zA-Z0-9]*$'
UnionName: '^\(anon|^\(unnamed|^[A-Z][a-zA-Z0-9]*$'
VariableName:
    ScopePrefix:
        Global: ''
        Static: ''
        ClassMember: ''
        StructMember: ''
    DataTypePrefix:
        String: ''
        Integer: ''
        Bool: ''
        Pointer: ''
    Pattern: '^[gmp]_unk0x[a-f0-9]{1,8}$|^(prop|event|desc|signal|func)_[a-zA-Z][a-zA-Z0-9]*$|^desc_Mouse_[A-Z][a-zA-Z0-9]*$|^(tag|name|value)_[a-zA-Z][a-zA-Z0-9]*(_[a-zA-Z][a-zA-Z0-9]*)?$|^(forward|backward|left|right)_(arrow|asdw)$|^workspace_(insertContent|makeJoints|breakJoints|SetThrottleEnabled|zoomToExtents)$|^fmod_channel$|^fmod_sound$|^fmod_version$|^listener_(pos|forward|up|vel)$|^sound_desc_[a-zA-Z][a-zA-Z0-9]*$|^sound_(play|pause|stop)Function$|^_type$|^_base64Chars$|^line_octets$|^category_[A-Z][a-zA-Z0-9]*$|^___Roblox_[A-Za-z0-9_]+$|^(IsControllable|IsTopFlag|TopPVController|PersistentPart|SurfacesNeedAdorn|FlagHeight|LocalGridExtents|WorldGridExtents|ControllersUsed)$|^(SMTPServer|SMTPAccountName)$|^(Top|Bottom|Left|Right|Front|Back)$|^(CPUSpeed|Frequency|StartCounter|EndCounter|Offset|Label)$|^cpu_name$|^num_faces$|^best_count$|^teams_rebalanceTeamsFunction$|^model_moveFunction(Old)?$|^(first_space|first_step|look_for_space)$|^_(cframe|castsShadows|cullable)$|^_(stencilShadows|alphaBlendShadowLights|useAllLightsInUnshadowedPass|skyBox|toneMap|hemisphereLighting|depthBlur|farCullZ|groundLOD|LODShift|shadowsEnabled|stripWidth)$|^[A-Z][A-Z0-9_]*$|^[a-z][a-zA-Z0-9]*$'
