ClassName: '^[A-Z][a-zA-Z0-9]*$'
CppMethod: '^operator|^on_[a-z][a-zA-Z0-9]*$|^FUN_[a-f0-9]{8}$|^print_exception$|^disconnect_all_slots$|^c_str$|^[a-zA-Z][a-zA-Z0-9]*$'
EnumName: '^\(unnamed|^[A-Z][a-zA-Z0-9]*$'
EnumConstantName: '^lego_[0-9]+$|^[A-Z][A-Z0-9_]*$|^[A-Z][a-zA-Z0-9]*$'
FunctionName: '^operator|^FUN_[a-f0-9]{8}$|^lua_(pushfunction|tofunction|tofloat)$|^[a-zA-Z][a-zA-Z0-9]*$'
ParameterName: '^p_unk0x[a-f0-9]{1,8}$|^_(First|Last|To|St|Endl)$|^L$|^_?[a-z][a-zA-Z0-9]*$|^$'
StructName: '^\(anon|^\(unnamed|^myLess$|^crlf$|^noline$|^lua_State$|^luaL_Reg$|^[A-Z][a-zA-Z0-9]*$'
TypedefName: '^[A-Z][a-zA-Z0-9]*$'
UnionName: '^\(anon|^\(unnamed|^[A-Z][a-zA-Z0-9]*$'
VariableName:
    ScopePrefix:
        Global: ''
        Static: ''
        ClassMember: ''
        StructMember: ''
    DataTypePrefix:
        String: ''
        Integer: ''
        Bool: ''
        Pointer: ''
    Pattern: '^[gmp]_unk0x[a-f0-9]{1,8}$|^(prop|event|desc)_[a-zA-Z][a-zA-Z0-9]*$|^(tag|name|value)_[a-zA-Z][a-zA-Z0-9]*(_[a-zA-Z][a-zA-Z0-9]*)?$|^(forward|backward|left|right)_(arrow|asdw)$|^fmod_channel$|^fmod_sound$|^_type$|^_base64Chars$|^line_octets$|^category_[A-Z][a-zA-Z0-9]*$|^___Roblox_[A-Za-z0-9_]+$|^(IsControllable|IsTopFlag|TopPVController|PersistentPart|SurfacesNeedAdorn|FlagHeight|LocalGridExtents|WorldGridExtents|ControllersUsed)$|^(SMTPServer|SMTPAccountName)$|^(Top|Bottom|Left|Right|Front|Back)$|^[A-Z][A-Z0-9_]*$|^[a-z][a-zA-Z0-9]*$'
