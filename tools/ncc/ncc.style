ClassName: '^[A-Z][a-zA-Z0-9]*$'
CppMethod: '^operator|^[a-zA-Z][a-zA-Z0-9]*$'
EnumName: '^\(unnamed|^[A-Z][a-zA-Z0-9]*$'
EnumConstantName: '^[A-Z][A-Z0-9_]*$|^[A-Z][a-zA-Z0-9]*$'
FunctionName: '^operator|^[a-zA-Z][a-zA-Z0-9]*$'
ParameterName: '^[a-z][a-zA-Z0-9]*$|^$'
StructName: '^\(anon|^\(unnamed|^[A-Z][a-zA-Z0-9]*$'
TypedefName: '^[A-Z][a-zA-Z0-9]*$'
UnionName: '^\(anon|^\(unnamed|^[A-Z][a-zA-Z0-9]*$'
VariableName:
    ScopePrefix:
        Global: ''
        Static: ''
        ClassMember: ''
        StructMember: ''
    DataTypePrefix:
        String: ''
        Integer: ''
        Bool: ''
        Pointer: ''
    Pattern: '^[a-z][a-zA-Z0-9]*$'
