import "oaidl.idl";
import "ocidl.idl";

typedef [public] enum WindowType {
	NoWindowType = 0,
	PlayWindowType = 2
} WINDOW_TYPE;

typedef [public] enum ErrorReporting {
	DontReport = 0,
	Prompt = 1,
	Report = 2
} ERROR_REPORTING;

[
	object,
	uuid(D63F927A-1170-4239-9C1D-06E8A658F300),
	dual,
	nonextensible,
	pointer_default(unique)
]
interface IContent : IDispatch {
	[id(1), helpstring("method Upload")] HRESULT Upload([in] BSTR url);
};

[
	object,
	uuid(0730C3C6-092D-4F45-B8B9-BDEB82DE1C7B),
	dual,
	nonextensible,
	pointer_default(unique)
]
interface IWorkspace : IDispatch {
	[id(3), hidden, restricted] HRESULT SaveToFile([in] BSTR pathName);
	[id(4), hidden, restricted] HRESULT SaveSelectionToFile([in] BSTR pathName);
	[id(5), helpstring("method Insert")] HRESULT Insert([in] BSTR url);
	[id(6), helpstring("method Write")] HRESULT Write([out, retval] IContent** result);
	[id(7), helpstring("method WriteSelection")] HRESULT WriteSelection([out, retval] IContent** result);
	[id(8), helpstring("method ExecScript")] HRESULT ExecScript([in] BSTR script, [in, optional] VARIANT arg1, [in, optional] VARIANT arg2, [in, optional] VARIANT arg3, [in, optional] VARIANT arg4, [out, retval] SAFEARRAY(VARIANT)* result);
	[id(9), helpstring("method ExecUrlScript")] HRESULT ExecUrlScript([in] BSTR url, [in, optional] VARIANT arg1, [in, optional] VARIANT arg2, [in, optional] VARIANT arg3, [in, optional] VARIANT arg4, [out, retval] SAFEARRAY(VARIANT)* result);
	[id(10), helpstring("method Close")] HRESULT Close();
};

[
	object,
	uuid(54F58168-734E-4379-B198-64B0826A002E),
	dual,
	nonextensible,
	pointer_default(unique)
]
interface IApp : IDispatch {
	[id(1)] HRESULT CreateGame([in] WINDOW_TYPE WindowType, [out, retval] IWorkspace** result);
	[id(2)] HRESULT LaunchIDE();
	[propget, id(4)] HRESULT Version([out, retval] BSTR* pVal);
	[propget, id(5)] HRESULT ErrorReporting([out, retval] ERROR_REPORTING* pVal);
	[propget, id(6)] HRESULT HasErrorFiles([out, retval] VARIANT_BOOL* pVal);
	[id(7)] HRESULT SendErrorFiles([in] BSTR url);
	[propget, id(8)] HRESULT IsUploadingErrorFiles([out, retval] VARIANT_BOOL* pVal);
	[id(9)] HRESULT DeleteErrorFiles();
	[id(10)] HRESULT ClearFileCache();
	[propget, id(11)] HRESULT ID([out, retval] BSTR* pVal);
	[id(12)] HRESULT RobloxAuthenticate([in] BSTR url, [in] BSTR ticket);
};

[
	object,
	uuid(D5AB3A9C-C462-48BA-A430-34B227340E42),
	dual,
	nonextensible,
	pointer_default(unique)
]
interface ILuaFunction : IDispatch {
	[id(1)] HRESULT Call([in, optional] VARIANT arg1, [in, optional] VARIANT arg2, [in, optional] VARIANT arg3, [in, optional] VARIANT arg4, [out, retval] VARIANT* result);
	[id(2)] HRESULT CallEx([in, optional] SAFEARRAY(VARIANT) args, [out, retval] SAFEARRAY(VARIANT)* result);
};

[
	object,
	uuid(E2ECE10D-9997-414B-B40B-0928B8F3CADB),
	dual,
	nonextensible,
	pointer_default(unique)
]
interface IBrowserViewExternal : IDispatch {
	[propget, id(1), helpstring("property IsRobloxIDE")] HRESULT IsRobloxIDE([out, retval] VARIANT_BOOL* pVal);
	[id(2)] HRESULT GetApp([out, retval] IDispatch** result);
};

