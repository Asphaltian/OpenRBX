1 TYPELIB "res\\Roblox.tlb"

STRINGTABLE
BEGIN
	128 "Roblox"
	129 "ROBLOX\nPlace\nPlace\nPlaces (*.rbxl)\n.rbxl\nRoblox.Level\nRoblox.Level"
	130 "&Undo %s\tCtrl+Z"
	131 "&Redo %s\tCtrl+Y"
	132 "Images (*.jpg;*.jpeg;*.tga;*.bmp;*.ico;*.png)|*.jpg; *.jpeg; *.tga; *.bmp; *.ico; *.png|All Files (*.*)|*.*||"
	133 "Failed to insert object of type ""%s"". Did you spell it correctly?"
	134 "Sounds (*.wav;*.mp3;*.mid;*.ogg;*.wma)|*.wav; *.mp3; *.mid; *.ogg; *.wma|All Files (*.*)|*.*||"
	135 "Pointer"
	136 "Changing settings may make ROBLOX unstable.\n\nWe recommend that you don't change any ROBLOX settings unless instructed to do so by a ROBLOX engineer."
	137 "Failed to create Service object of type ""%s"""
	138 "Object Browser\nObject Browser\n\n\n\n\n"
